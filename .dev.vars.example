# Зразок. Скопіюйте у файл .dev.vars і підставте свої значення.
#
#     cp .dev.vars.example .dev.vars
#
# .dev.vars у git не потрапляє (див. .gitignore) — і не має потрапити:
# репозиторій публічний, а з цим токеном будь-хто зможе писати від
# імені вашого бота і читати заявки клієнтів.
#
# wrangler pages dev підхоплює цей файл сам, передавати нічого не треба.
# Ті самі три змінні в продакшні задаються в Cloudflare Pages →
# Settings → Environment variables, усі три типу Secret.
#
# Значення можна брати в лапки, а можна без: і wrangler, і скрипти
# проєкту лапки знімають однаково.

# Видає @BotFather після /newbot. Виглядає як 1234567890:AA...
TELEGRAM_BOT_TOKEN=

# Куди бот надсилатиме заявки. Дізнатися: напишіть боту будь-що
# в Telegram, потім запустіть `npm run telegram:chat-id`
TELEGRAM_CHAT_ID=

# Секрет вебхука. Telegram підставляє його в заголовок кожного запиту
# на /api/tg — без нього ендпоінт відкидає запит. Вигадайте довгий
# випадковий рядок, наприклад:
#     node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
TELEGRAM_WEBHOOK_SECRET=
