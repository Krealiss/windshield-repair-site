# Зразок. Скопіюйте у файл .dev.vars і підставте свої значення.
#
#     cp .dev.vars.example .dev.vars
#
# .dev.vars у git не потрапляє (див. .gitignore) — і не має потрапити:
# репозиторій публічний, а з цим токеном будь-хто зможе писати від
# імені вашого бота і читати заявки клієнтів.
#
# wrangler pages dev підхоплює цей файл сам, передавати нічого не треба.
# У продакшні ці змінні задаються в Cloudflare Pages →
# Settings → Environment variables. Токен, chat_id і секрет вебхука —
# типу Secret; OWNER_TG_ID секретом не є, але хай лежить поруч.
#
# Значення можна брати в лапки, а можна без: і wrangler, і скрипти
# проєкту лапки знімають однаково.

# Видає @BotFather після /newbot. Виглядає як 1234567890:AA...
TELEGRAM_BOT_TOKEN=

# Куди бот надсилатиме заявки — група з власником і майстрами.
# Дізнатися: додайте бота в групу, напишіть там будь-що, потім
# запустіть `npm run telegram:chat-id`. Id групи відʼємний.
TELEGRAM_CHAT_ID=

# Особистий Telegram-номер власника — саме людини, а не чату.
# Потрібен CRM: по ньому скрипт `npm run crm:seed-owner` заводить
# першого користувача в таблицю users, бо інакше глухий кут — зайти
# може лише той, хто вже в списку, а завести перший рядок нікому.
# Не міграція: міграція — чистий SQL і змінних оточення не читає, а
# особистий номер власника не має лежати у файлі під git.
#
# Не плутати з TELEGRAM_CHAT_ID. Поки бот писав власнику в особисті,
# це був один і той самий номер; відколи він пише в групу — різні.
# Якщо значення загубилось: напишіть боту в особисті й запустіть
# `npm run telegram:chat-id` — ваш особистий чат зʼявиться в списку.
OWNER_TG_ID=

# Секрет вебхука. Telegram підставляє його в заголовок кожного запиту
# на /api/tg — без нього ендпоінт відкидає запит. Вигадайте довгий
# випадковий рядок, наприклад:
#     node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
TELEGRAM_WEBHOOK_SECRET=

# Ключ, яким підписується кука сесії CRM. Будь-який довгий випадковий
# рядок; змінити його = вигнати всіх із сесій.
#     node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=
