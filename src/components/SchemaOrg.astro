---
import type { SiteData } from '../lib/site';
import { padTime } from '../lib/format';

interface Props {
  site: SiteData;
}

const { site } = Astro.props;
const { contacts, coverage, reviews, faq } = site;

const DAY_MAP: Record<string, string> = {
  'Понеділок': 'Monday',
  'Вівторок': 'Tuesday',
  'Середа': 'Wednesday',
  'Четвер': 'Thursday',
  "П'ятниця": 'Friday',
  'Субота': 'Saturday',
  'Неділя': 'Sunday',
};

// ── основна сутність ──────────────────────────────────────
const business: Record<string, unknown> = {
  '@type': 'AutoRepair',
  '@id': `${Astro.site}#business`,
  // Бренд латиницею — як у шапці й у домені. Кириличне написання
  // лишається другим ім'ям: шукають саме «автоскло», і розмітка
  // мусить знати обидва, інакше Google не звʼяже сайт із запитом.
  // Назва тут і напис у шапці мусять збігатися — Google звіряє їх
  // із Google Business Profile.
  name: 'Avtoskloua',
  alternateName: 'Автоскло',
  telephone: contacts.phone_main, // у schema завжди реальний, не трекінговий
  address: {
    '@type': 'PostalAddress',
    streetAddress: contacts.address,
    addressCountry: 'UA',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: contacts.lat,
    longitude: contacts.lng,
  },
  url: Astro.site?.toString(),
  // priceRange свідомо немає: ціни на сайті не публікуються, їх називає
  // оператор телефоном. Вигаданий діапазон у розмітці — гірше за його брак.
};

// areaServed навмисно грубий — два широких значення (місто й область),
// а не перелік районів чи населених пунктів. Адреса лишається реальною
// (майстерня в Софіївській Борщагівці), а areaServed окремо описує зону
// виїзду. Значення бере з src/content/coverage.yml, не хардкодиться тут.
if (coverage.areas.length) {
  business.areaServed = coverage.areas.map((name) => ({
    '@type': 'Place',
    name,
  }));
}

if (contacts.hours.length) {
  business.openingHoursSpecification = contacts.hours
    .filter((h) => !h.closed && h.from && h.to)
    .map((h) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: DAY_MAP[h.day] ?? h.day,
      // schema.org чекає HH:MM. Власник цілком може ввести «9:00»,
      // і Google мовчки відкине всю розмітку графіка.
      opens: padTime(h.from!),
      closes: padTime(h.to!),
    }));
}

// Агрегований рейтинг тільки якщо відгуків достатньо.
// Google знімає розмітку за фейкові або поодинокі оцінки.
if (reviews.length >= 3) {
  const avg = reviews.reduce((s, r) => s + r.rating, 0) / reviews.length;
  business.aggregateRating = {
    '@type': 'AggregateRating',
    ratingValue: avg.toFixed(1),
    reviewCount: reviews.length,
    bestRating: 5,
  };
}

// ── FAQ ────────────────────────────────────────────────────
// Сторінка одна, тож дублювати FAQPage нема з чим — розмітка йде завжди,
// коли в контенті є хоч одне питання з in_schema: true.
const faqItems = faq.filter((f) => f.in_schema);
const faqNode = faqItems.length
  ? {
      '@type': 'FAQPage',
      mainEntity: faqItems.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    }
  : null;

// У @graph лишається сутність бізнесу і FAQ.
// Вузлів Service тут більше немає: без ціни Offer порожній, а Service
// без нього лише дублює назву послуги, яку Google і так бачить у тексті.
const graph = [business, ...(faqNode ? [faqNode] : [])];
const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<!-- canonical живе в Base.astro: він потрібен усім сторінкам, а schema.org — ні -->
<script
  type="application/ld+json"
  set:html={JSON.stringify(jsonLd)}
/>
