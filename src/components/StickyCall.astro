---
import { formatPhone, telHref, viberHref, telegramHref } from '../lib/format';

interface Props {
  phone: string;
  viber?: string;
  telegram?: string;
}

const { phone, viber, telegram } = Astro.props;
---

<!--
  Панель дзвінка, прилипла до низу на мобільному.

  Чому IntersectionObserver, а не scroll-listener:
  scroll спрацьовує сотні разів на секунду і смикає головний потік
  саме тоді, коли людина гортає. Observer коштує нуль.

  Панель з'являється тільки коли перший екран пішов угору — інакше
  вона дублює кнопку, яка й так на видноті, і з'їдає частину екрана.

  Сентинел, за яким стежить спостерігач, ставить сторінка — наприкінці
  свого першого екрана (див. Hero.astro і vyizdnyi-remont.astro).
  Тут його немає навмисно: цей компонент рендериться в кінці <body>,
  і власний сентинел опинявся б унизу сторінки, тобто означав би
  протилежне тому, що потрібно.
-->
<div class="sticky-call" id="sticky-call" data-visible="false">
  <a
    class="sticky-call__main"
    href={telHref(phone)}
    data-cta="sticky"
    data-phone
    aria-label={`Подзвонити ${formatPhone(phone)}`}
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M6.6 10.8a15.1 15.1 0 006.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 013 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1l-2.3 2.2z"/>
    </svg>
    <span>Подзвонити</span>
  </a>

  <!--
    Іконки замість підписів: три написи поруч з'їдали ширину головної
    кнопки, а важлива тут вона. Назви лишилися в aria-label — візуально
    тексту немає, але для читалки екрана це єдине, чим одне посилання
    відрізняється від іншого.

    Малюємо інлайном: зовнішній файл — запит перед першим рендером,
    шрифт іконок — сотні кілобайтів заради двох символів.
  -->
  {viber && (
    <a class="sticky-call__alt" href={viberHref(viber)} data-cta="sticky" aria-label="Написати у Viber">
      <!-- Трубка в закругленому квадраті: за цією формою Viber і пізнають -->
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <rect x="3.1" y="2.6" width="17.8" height="17.8" rx="5.6" fill="none" stroke="currentColor" stroke-width="1.8"></rect>
        <path d="M9.8 7.4c.55-.22 1.18.02 1.45.55l.7 1.37c.24.48.1 1.07-.34 1.38l-.42.3a5.9 5.9 0 003.06 3.06l.3-.42c.31-.44.9-.58 1.38-.34l1.37.7c.53.27.77.9.55 1.45-.3.76-1.06 1.23-1.87 1.15-3.6-.36-6.46-3.22-6.82-6.82-.08-.81.39-1.57 1.15-1.87z" fill="currentColor"></path>
      </svg>
    </a>
  )}
  {telegram && (
    <a class="sticky-call__alt" href={telegramHref(telegram)} data-cta="sticky" aria-label="Написати в Telegram">
      <!-- Паперовий літачок: контур плюс лінія згину, інакше на 22px це просто трикутник -->
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M21.4 2.6 14.6 21.5 10.8 13.2 2.5 9.4z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
        <path d="M21.4 2.6 10.8 13.2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
      </svg>
    </a>
  )}
</div>

<style>
  .sticky-call {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    display: flex;
    gap: 0.5rem;
    padding: 0.6rem 0.75rem;
    /* Виріз під домашню смугу iPhone */
    padding-bottom: calc(0.6rem + env(safe-area-inset-bottom, 0px));
    background: var(--surface);
    border-top: 1px solid var(--border);
    box-shadow: var(--shadow-up);
    transform: translateY(110%);
    transition: transform 0.22s ease-out;
  }

  .sticky-call[data-visible='true'] {
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .sticky-call { transition: none; }
  }

  /* На десктопі панель не потрібна — там телефон у шапці */
  @media (min-width: 768px) {
    .sticky-call { display: none; }
  }

  .sticky-call__main {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    /* 48px — мінімальна ціль дотику */
    min-height: 48px;
    border-radius: var(--r);
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
    font-size: 1.05rem;
    text-decoration: none;
  }

  /*
    Кнопка без тексту все одно мусить лишатися ціллю для пальця:
    48px по обох вимірах — той самий мінімум, що й у головної кнопки.
    padding тут не допоміг би, бо ширину задає вже не напис, а іконка.
  */
  .sticky-call__alt {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    min-width: 48px;
    padding: 0 0.7rem;
    border: 1px solid var(--border);
    border-radius: var(--r);
    /* Іконки малюються currentColor — колір задається тут, в одному місці */
    color: var(--text);
    text-decoration: none;
  }

  .sticky-call__alt svg {
    width: 22px;
    height: 22px;
    flex: none;
  }
</style>

<script>
  const bar = document.getElementById('sticky-call');
  const sentinel = document.getElementById('sticky-sentinel');

  if (bar) {
    if (sentinel && 'IntersectionObserver' in window) {
      new IntersectionObserver(
        ([entry]) => {
          // Сентинел видно = ми на першому екрані = панель ховаємо
          bar.dataset.visible = entry.isIntersecting ? 'false' : 'true';
        },
        { rootMargin: '0px' }
      ).observe(sentinel);
    } else {
      // Старий браузер або сторінка без сентинела — показуємо завжди.
      // Краще зайва панель, ніж кнопка дзвінка, якої немає ніде.
      bar.dataset.visible = 'true';
    }
  }
</script>
