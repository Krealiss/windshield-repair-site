---
/**
 * Іконки Viber і Telegram — залитий круг фірмового кольору з білим
 * гліфом усередині. Раніше цей SVG був намальований окремо в
 * Contacts.astro і в StickyCall.astro — саме той клас помилки, коли
 * правиш іконку в одному місці, а друга копія тихо розходиться.
 * Тепер малюнок один, підключають його звідусіль.
 *
 * Компонент віддає лише сам SVG. Кнопку (розмір цілі дотику, рамку,
 * aria-label) кожне місце малює по-своєму — це стосується розмітки
 * навколо іконки, а не самої іконки.
 *
 * Кольори чужих брендів фіксовані тут навмисно: вони не залежать від
 * теми сайту й не мають потрапляти в токени палітри.
 */
export type SocialIconKind = 'viber' | 'telegram';

interface Props {
  kind: SocialIconKind;
}

const { kind } = Astro.props;
---

{kind === 'viber' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="12" fill="#7360F2"></circle>
    <path d="M8.4 9.8a10.3 10.3 0 004.8 4.8l1.5-1.5c.2-.2.5-.3.7-.2.8.3 1.7.4 2.6.4.4 0 .7.3.7.7v2.3c0 .4-.3.7-.7.7A12.3 12.3 0 015.9 5.6c0-.4.3-.7.7-.7H9c.4 0 .7.3.7.7 0 .9.1 1.8.4 2.6.1.3 0 .6-.2.7l-1.5 1.6z" fill="#fff"></path>
  </svg>
)}
{kind === 'telegram' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="12" fill="#2AABEE"></circle>
    <path d="M18.4 6.4 5.9 11.3c-.5.2-.5.9 0 1.1l3 1 1.2 3.7c.2.5.8.6 1.1.2l1.6-1.7 3.2 2.4c.4.3 1 .1 1.1-.4l2.1-9.9c.1-.6-.5-1.1-1-.8z" fill="#fff"></path>
    <path d="M9.7 13.9 16 9.4c.3-.2.6.1.3.4l-5.2 4.9-.2 2.1z" fill="#2AABEE"></path>
  </svg>
)}

<style>
  svg {
    width: 22px;
    height: 22px;
    flex: none;
    display: block;
  }
</style>
