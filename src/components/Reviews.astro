---
interface Props {
  reviews: Array<{
    author: string;
    text: string;
    rating: number;
    date: Date;
    source?: string;
  }>;
}
const { reviews } = Astro.props;

const fmt = new Intl.DateTimeFormat('uk-UA', { month: 'long', year: 'numeric' });
---

<section class="band rev" id="vidhuky">
  <h2>Відгуки</h2>

  <ul class="rev__list">
    {reviews.map((r) => (
      <li class="rev__item">
        <div class="rev__head">
          <strong>{r.author}</strong>
          <!--
            Зірки намальовані, а не написані символом ★: у шрифті сайту
            цього гліфа немає, і браузер підставляв би чужу гарнітуру —
            п'ять зірок різного накреслення в одному рядку.
          -->
          <span class="rev__stars" role="img" aria-label={`Оцінка ${r.rating} з 5`}>
            {[1, 2, 3, 4, 5].map((i) => (
              <svg
                class={i <= r.rating ? 'is-on' : undefined}
                viewBox="0 0 20 20"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M10 1.6l2.5 5.1 5.6.8-4 3.9 1 5.6-5.1-2.7-5 2.7 1-5.6-4.1-3.9 5.6-.8z" />
              </svg>
            ))}
          </span>
        </div>
        <p class="rev__text">{r.text}</p>
        <p class="rev__meta">
          <time datetime={r.date.toISOString()}>{fmt.format(r.date)}</time>
          {r.source && <><span aria-hidden="true"> · </span>{r.source}</>}
        </p>
      </li>
    ))}
  </ul>
</section>

<style>
  .rev { display: grid; gap: 1.15rem; }

  .rev__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.85rem; }

  .rev__item {
    padding: 1.15rem;
    border: 1px solid var(--border);
    border-radius: var(--r);
    background: var(--surface);
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }

  .rev__head { display: flex; justify-content: space-between; align-items: baseline; gap: 0.75rem; }
  .rev__head strong { letter-spacing: -0.01em; }
  .rev__stars { display: inline-flex; gap: 0.1rem; flex: none; }
  .rev__stars svg { width: 15px; height: 15px; fill: var(--star-off); }
  .rev__stars svg.is-on { fill: var(--star); }

  .rev__text { margin: 0; font-size: 0.95rem; line-height: 1.6; }
  .rev__meta { margin: 0; font-size: 0.8rem; color: var(--muted); }

  @media (min-width: 620px) {
    .rev__list { grid-template-columns: 1fr 1fr; }
  }
</style>
