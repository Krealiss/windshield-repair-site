---
/**
 * Заглушка на місці головного зображення.
 *
 * ЦЕ ТИМЧАСОВО. Щойно з'являться реальні знімки роботи — цей компонент
 * має замінити фото (найкраще «до/після» одного й того самого сколу).
 * Жодна векторна картинка не продає ремонт так, як фотографія результату:
 * у всіх конкурентів перший екран тримається саме на знімках.
 *
 * Поки фото немає, порожнеча гірша за акуратну графіку: сторінка без
 * жодного зображення читається як макет, а не як сайт.
 *
 * Намальовано, а не завантажено: SVG важить близько кілобайта,
 * вбудовується в HTML і не додає жодного запиту.
 */
---

<div class="hv" role="img" aria-label="Скол на лобовому склі — схематично">
  <svg viewBox="0 0 480 360" preserveAspectRatio="xMidYMid slice" focusable="false">
    <defs>
      <linearGradient id="hv-glass" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#e8effb" />
        <stop offset="55%" stop-color="#cfdcf2" />
        <stop offset="100%" stop-color="#aebfdb" />
      </linearGradient>
      <linearGradient id="hv-sheen" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#ffffff" stop-opacity="0.55" />
        <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
      </linearGradient>
      <radialGradient id="hv-impact">
        <stop offset="0%" stop-color="#ffffff" stop-opacity="0.95" />
        <stop offset="60%" stop-color="#f8fafc" stop-opacity="0.5" />
        <stop offset="100%" stop-color="#94a3b8" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="hv-halo">
        <stop offset="0%" stop-color="#ffffff" stop-opacity="0.75" />
        <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
      </radialGradient>
    </defs>

    <!-- Скло -->
    <rect width="480" height="360" fill="url(#hv-glass)" />

    <!-- Відблиск: широка діагональна смуга -->
    <path d="M-40 300 L200 -40 L330 -40 L20 360 Z" fill="url(#hv-sheen)" />

    <!-- Ледь помітні смуги, щоб площина не була мертвою -->
    <g stroke="#ffffff" stroke-opacity="0.22" stroke-width="1">
      <path d="M330 -10 L120 370" />
      <path d="M395 -10 L185 370" />
    </g>

    <!-- Ореол навколо удару -->
    <circle cx="252" cy="172" r="112" fill="url(#hv-halo)" />

    <!-- Промені сколу: різна довжина і товщина, інакше схоже на сніжинку -->
    <g
      stroke="#64748b"
      stroke-linecap="round"
      fill="none"
      transform="translate(252 172) scale(1.35)"
    >
      <path d="M0 0 C -6 -22, -10 -42, -8 -66" stroke-width="2.4" stroke-opacity="0.75" />
      <path d="M0 0 C 16 -14, 32 -24, 52 -30" stroke-width="2" stroke-opacity="0.68" />
      <path d="M0 0 C 22 6, 44 12, 70 12" stroke-width="2.6" stroke-opacity="0.72" />
      <path d="M0 0 C 12 20, 20 38, 22 58" stroke-width="1.8" stroke-opacity="0.6" />
      <path d="M0 0 C -10 18, -24 32, -44 40" stroke-width="2.2" stroke-opacity="0.66" />
      <path d="M0 0 C -20 -4, -40 -6, -58 -2" stroke-width="1.6" stroke-opacity="0.55" />
      <path d="M0 0 C -16 -14, -28 -24, -34 -36" stroke-width="1.3" stroke-opacity="0.45" />

      <!-- Дрібні відгалуження -->
      <g stroke-width="1" stroke-opacity="0.4">
        <path d="M-8 -46 C -16 -50, -22 -56, -25 -63" />
        <path d="M40 -27 C 46 -33, 52 -36, 60 -38" />
        <path d="M56 11 C 64 16, 70 20, 76 26" />
        <path d="M-36 35 C -42 41, -48 44, -55 46" />
      </g>
    </g>

    <!-- Точка удару -->
    <circle cx="252" cy="172" r="19" fill="url(#hv-impact)" />
    <circle cx="252" cy="172" r="5.5" fill="#475569" fill-opacity="0.55" />
  </svg>
</div>

<style>
  .hv {
    width: 100%;
    aspect-ratio: 4 / 3;
    max-height: 15rem;
    border-radius: var(--r-lg);
    overflow: hidden;
    border: 1px solid rgba(15, 23, 42, 0.08);
    box-shadow: var(--shadow);
  }
  .hv svg { width: 100%; height: 100%; display: block; }

  @media (min-width: 900px) {
    .hv { max-height: none; aspect-ratio: 4 / 3.1; }
  }
</style>
