---
/**
 * «Ремонт чи заміна» — найважливіший текстовий блок сайту.
 *
 * Він робить дві речі одночасно:
 *   1. Продає ремонт проти заміни (дешевше, швидше, заводське скло)
 *   2. Чесно каже, коли ремонт неможливий
 *
 * Другий пункт виглядає як втрата клієнтів, але працює навпаки:
 * людина, яка прочитала обмеження і все одно подзвонила, вже
 * прогріта. А людина, якій пообіцяли неможливе, приїде, отримає
 * відмову і напише негативний відгук.
 *
 * Тексти захардкожені навмисно — це позиціювання, а не контент.
 * Власник не має правити їх на ходу.
 */

const advantages = [
  {
    title: 'Дешевше в кілька разів',
    text: 'Ремонт сколу коштує значно менше за нове скло з роботою.',
  },
  {
    title: 'Заводське скло лишається',
    text: 'Не порушується заводська герметизація — після заміни по периметру інколи з’являються протікання і шум.',
  },
  {
    title: 'Швидше',
    text: 'Ремонт — до години. Заміна забирає півдня і потребує часу на застигання клею.',
  },
  {
    title: 'Скол не піде далі',
    text: 'Головна задача — зупинити тріщину, поки вона не пішла через усе скло від вібрації чи перепаду температур.',
  },
];

const limits = [
  'Тріщина починається від краю скла',
  'Пошкодження в зоні прямого огляду водія',
  'Скол більший за 5-гривневу монету',
  'Скол давній, забився брудом і вологою',
  'Пошкоджений внутрішній шар триплексу',
];
---

<section class="band band--alt rvr">
  <h2>Ремонт замість заміни</h2>

  <ul class="rvr__adv">
    {advantages.map((a) => (
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="10" fill="var(--accent-soft)"></circle>
          <path d="M7.8 12.3l2.7 2.7 5.7-5.9" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <div>
          <strong>{a.title}</strong>
          <span>{a.text}</span>
        </div>
      </li>
    ))}
  </ul>

  <div class="rvr__limits">
    <h3>Коли ремонт не допоможе</h3>
    <ul>
      {limits.map((l) => <li>{l}</li>)}
    </ul>
    <p class="rvr__note">
      Якщо ваш випадок у цьому списку — скажу відразу, і ви не витратите час
      на дорогу. Надішліть фото, і я відповім чесно.
    </p>
  </div>

  <p class="rvr__expect">
    <strong>Про результат чесно:</strong> скол не зникає безслідно. Залишається
    ледь помітна точка, яку не видно з водійського місця. Задача ремонту —
    зупинити руйнування і зберегти скло, а не зробити його новим.
  </p>
</section>

<style>
  .rvr { display: grid; gap: 1.5rem; }
  .rvr h3 { margin: 0 0 0.6rem; font-size: 1.05rem; letter-spacing: -0.01em; }

  .rvr__adv { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.1rem; }
  .rvr__adv li { display: grid; grid-template-columns: 24px 1fr; gap: 0.7rem; align-items: start; }
  .rvr__adv svg { width: 24px; height: 24px; margin-top: 0.1rem; }
  .rvr__adv div { display: grid; gap: 0.2rem; }
  .rvr__adv strong { font-size: 1rem; letter-spacing: -0.01em; }
  .rvr__adv span { font-size: 0.94rem; line-height: 1.55; color: var(--muted); }

  .rvr__limits {
    padding: 1.15rem;
    border-radius: var(--r);
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .rvr__limits ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.5rem; }
  .rvr__limits li {
    position: relative;
    padding-left: 1.4rem;
    font-size: 0.94rem;
    line-height: 1.5;
  }
  /* Риска замість маркера: список обмежень, а не переваг */
  .rvr__limits li::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: 0.68em;
    width: 0.7rem;
    height: 2px;
    border-radius: 2px;
    background: var(--rule);
  }
  .rvr__note { margin: 0.9rem 0 0; font-size: 0.9rem; line-height: 1.55; color: var(--muted); }

  .rvr__expect {
    margin: 0;
    padding: 1rem 1.15rem;
    border-left: 3px solid var(--accent);
    border-radius: 0 var(--r-sm) var(--r-sm) 0;
    background: var(--surface);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  @media (min-width: 768px) {
    .rvr__adv { grid-template-columns: 1fr 1fr; gap: 1.4rem 2.25rem; }
  }
</style>
