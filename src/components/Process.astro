---
interface Props {
  coverage: {
    areas: string[];
    travel_fee: number;
    radius_km?: number;
    conditions?: string;
  };
  address: string;
}
const { coverage, address } = Astro.props;

// Тільки сама вартість дороги. Приписки «безкоштовно від N грн» тут колись
// був сенс: поруч стояв прайс, і людина бачила, чи дотягує її випадок до
// порога. Цін на сайті більше немає — поріг перетворився на суму без
// одиниці виміру, а про безкоштовний виїзд зручніше сказати телефоном.
const feeText =
  coverage.travel_fee === 0
    ? 'Виїзд безкоштовний'
    : `Виїзд ${coverage.travel_fee} грн`;

const steps = [
  { n: 1, t: 'Дзвінок або фото', d: 'Оцінюю пошкодження і називаю ціну ще до зустрічі.' },
  { n: 2, t: 'Очищення сколу', d: 'Прибираю бруд і вологу з каналу — без цього полімер не зчепиться.' },
  { n: 3, t: 'Заповнення полімером', d: 'Під вакуумом, щоб не лишилось повітря в тріщині.' },
  { n: 4, t: 'Полімеризація і поліровка', d: 'Ультрафіолет, зачистка поверхні врівень зі склом.' },
];
---

<section class="band band--dark process">
  <h2>Як це відбувається</h2>

  <ol class="process__steps">
    {steps.map((s) => (
      <li>
        <span class="process__num" aria-hidden="true">{s.n}</span>
        <div>
          <strong>{s.t}</strong>
          <span>{s.d}</span>
        </div>
      </li>
    ))}
  </ol>

  <div class="process__where">
    <div class="process__card">
      <h3>Приїжджайте до нас</h3>
      <p>{address}</p>
    </div>

    <div class="process__card">
      <h3>Або виїдемо до вас</h3>
      <p>{feeText}</p>
      {coverage.areas.length > 0 && (
        <p class="process__areas">{coverage.areas.join(' · ')}</p>
      )}
      {coverage.conditions && <p class="process__cond">{coverage.conditions}</p>}

      <!--
        Змістове посилання на другу сторінку, а не лише у футері.
        Анкор із ключовою фразою: пошуковик бачить, про що сторінка,
        а людина потрапляє туди з місця, де саме про це й подумала.
      -->
      <p class="process__more">
        <a href="/vyizdnyi-remont/">Умови виїзного ремонту лобового скла →</a>
      </p>
    </div>
  </div>
</section>

<style>
  .process { display: grid; gap: 1.75rem; }
  .process h3 { margin: 0 0 0.4rem; font-size: 1.02rem; letter-spacing: -0.01em; }

  .process__steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }

  .process__steps li {
    position: relative;
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    gap: 0.85rem;
    align-items: start;
    padding-bottom: 1.35rem;
  }
  /* Лінія, що з'єднує кроки: показує, що це послідовність, а не набір */
  .process__steps li::before {
    content: '';
    position: absolute;
    left: calc(1.125rem - 1px);
    top: 2.25rem;
    bottom: 0.35rem;
    width: 2px;
    background: var(--border);
  }
  .process__steps li:last-child { padding-bottom: 0; }
  .process__steps li:last-child::before { display: none; }

  .process__steps div { display: grid; gap: 0.2rem; }
  .process__steps strong { letter-spacing: -0.01em; }
  .process__steps span:not(.process__num) { font-size: 0.94rem; color: var(--muted); line-height: 1.55; }

  .process__num {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 700;
    font-size: 0.95rem;
    /* Обвідка кольором смуги: кружок «перерізає» лінію між кроками */
    box-shadow: 0 0 0 4px var(--band-dark-bg);
  }

  .process__where { display: grid; gap: 0.85rem; }
  .process__card {
    padding: 1.15rem;
    border: 1px solid var(--border);
    border-radius: var(--r);
    background: var(--surface-alt);
  }
  .process__card p { margin: 0; font-size: 0.95rem; line-height: 1.55; }
  .process__areas { margin-top: 0.4rem !important; color: var(--muted); font-size: 0.9rem !important; }
  .process__cond { margin-top: 0.55rem !important; color: var(--muted); font-size: 0.86rem !important; }

  .process__more { margin-top: 0.8rem !important; font-size: 0.92rem !important; }
  .process__more a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    color: var(--link);
    font-weight: 600;
    text-decoration: none;
  }
  .process__more a:hover { text-decoration: underline; }

  @media (min-width: 768px) {
    .process__where { grid-template-columns: 1fr 1fr; gap: 1rem; }
  }
</style>
