---
import { formatPrice, telHref } from '../lib/format';

interface Props {
  services: Array<{
    title: string;
    price_from: number;
    duration_min?: number;
    note?: string;
  }>;
  phone: string;
}
const { services, phone } = Astro.props;
---

<!--
  Ціни другим блоком. Слово «від» і «грн» додаються тут, а не
  зберігаються в контенті — інакше в таблиці зʼявиться
  «500грн», «від 500 грн.» і «500» одночасно.

  Картки, а не рядки таблиці: на телефоні назва й ціна в одному
  рядку неминуче стикаються, і довша назва ламає вирівнювання.
-->
<section class="band prices">
  <h2>Ціни</h2>

  <ul class="prices__list">
    {services.map((s) => (
      <li class="prices__item">
        <div class="prices__body">
          <span class="prices__title">{s.title}</span>
          {s.note && <span class="prices__note">{s.note}</span>}
        </div>
        <div class="prices__right">
          <span class="prices__price">{formatPrice(s.price_from)}</span>
          {s.duration_min && (
            <span class="prices__time">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
                <path d="M12 7v5.3l3.4 2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
              </svg>
              {s.duration_min} хв
            </span>
          )}
        </div>
      </li>
    ))}
  </ul>

  <p class="prices__disclaimer">
    Точна ціна залежить від розміру й типу пошкодження. Надішліть фото
    або зателефонуйте — скажу відразу, без огляду на місці.
  </p>

  <a class="btn btn--ghost prices__cta" href={telHref(phone)} data-cta="prices">
    Дізнатися ціну
  </a>
</section>

<style>
  .prices { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.35rem; justify-items: start; }

  .prices__list {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    display: grid;
    gap: 0.75rem;
  }

  .prices__item {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.05rem 1.15rem;
    border: 1px solid var(--border);
    border-radius: var(--r);
    background: var(--surface);
    transition: border-color 0.15s ease-out, box-shadow 0.15s ease-out;
  }
  .prices__item:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow);
  }

  .prices__body { display: grid; gap: 0.2rem; }
  .prices__title { font-weight: 600; line-height: 1.35; }
  .prices__note { font-size: 0.86rem; color: var(--muted); line-height: 1.4; }

  .prices__right { display: grid; justify-items: end; gap: 0.25rem; white-space: nowrap; }
  .prices__price {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: -0.01em;
  }
  .prices__time {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.83rem;
    color: var(--muted);
  }
  .prices__time svg { width: 14px; height: 14px; flex: none; }

  .prices__disclaimer {
    margin: 0;
    font-size: 0.95rem;
    color: var(--muted);
    max-width: 56ch;
  }

  @media (min-width: 620px) {
    .prices__list { grid-template-columns: 1fr 1fr; gap: 0.85rem; }
  }
</style>
