---
import Base from '../layouts/Base.astro';
import { loadSite } from '../lib/site';
import { formatPhone, telHref } from '../lib/format';

const site = await loadSite();
---

<Base
  title="Сторінку не знайдено"
  description="Такої сторінки немає."
  noindex={true}
  phone={site.phone}
>
  <section class="band nf">
    <h1>Такої сторінки немає</h1>
    <p>Можливо, посилання застаріло.</p>
    <a class="btn btn--primary" href="/">← На головну</a>
    <p class="nf__hint">Або просто зателефонуйте:</p>
    <a class="btn btn--primary btn--lg" href={telHref(site.phone)} data-cta="404" data-phone>
      {formatPhone(site.phone)}
    </a>
  </section>
</Base>

<style>
  .nf { display: grid; gap: 0.9rem; justify-items: start; }
  .nf h1 {
    margin: 0;
    font-size: clamp(1.6rem, 6vw, 2.2rem);
    letter-spacing: -0.02em;
  }
  .nf p { margin: 0; }
  .nf__hint { color: var(--muted); font-size: 0.95rem; margin-top: 0.35rem !important; }
</style>
