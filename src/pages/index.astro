---
import Base from '../layouts/Base.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import Analytics from '../components/Analytics.astro';
import StickyCall from '../components/StickyCall.astro';
import Hero from '../components/Hero.astro';
import RepairVsReplace from '../components/RepairVsReplace.astro';
import Location from '../components/Location.astro';
import Gallery from '../components/Gallery.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import LeadForm from '../components/LeadForm.astro';
import Contacts from '../components/Contacts.astro';
import { loadSite } from '../lib/site';
import { buildNav } from '../lib/nav';

const site = await loadSite();
const { contacts, meta, phone, show } = site;

// Пункти меню — з того, що реально відрисовано нижче
const nav = buildNav(show);
---

<Base
  title={meta.seo_title}
  description={meta.seo_description}
  phone={phone}
  overHero
  nav={nav}
  viber={contacts.viber}
  telegram={contacts.telegram}
  address={contacts.address}
>
  <SchemaOrg slot="head" site={site} />
  <Analytics slot="head" gtmId={import.meta.env.PUBLIC_GTM_ID} />

  <!--
    Порядок блоків не випадковий. Він відповідає порядку питань
    у голові людини зі сколом:

    1. Ви це робите і де ви?        → Hero
    2. А в мене взагалі ремонтується?→ RepairVsReplace
    3. Де це робиться, чи приїдете? → Location
    4. Покажіть результат           → Gallery
    5. Дрібні сумніви               → Faq
    6. Добре, як звʼязатися         → LeadForm
    7. Вам можна вірити?            → Reviews
    8. Якщо дзвонити зараз          → Contacts

    Питання «скільки коштує» свідомо не має блоку-відповіді: ціну називає
    оператор телефоном. Тому другим іде саме «чи ремонтується мій випадок» —
    наступне за силою питання, на яке сторінка може відповісти сама.

    Відгуки стоять ПІСЛЯ форми на вимогу замовника. Це не загальне
    правило, а ставка: класичний порядок відповідає на «вам можна
    вірити» до прохання лишити заявку, а тут доказ довіри стоїть поруч
    із самою формою — для того, хто вже навів курсор, але вагається.
    Якщо конверсія впаде, першим підозрюваним має бути саме цей порядок.
  -->

  <Hero
    h1={meta.h1}
    subtitle={meta.hero_subtitle}
    phone={phone}
    chips={[
      /*
        Час — перший за силою чіп: «гарантія» і адреса нічого не
        обіцяють людині, яка вирішує, дзвонити чи ні, а «30–40 хвилин»
        обіцяє. Число не нове: те саме стоїть у відповідях на питання
        (src/content/faq/tryvalist.yml), і розходитись вони не мають.
      */
      { icon: 'clock', text: 'Скол — 30–40 хвилин' },
      /*
        «або за вашою адресою» дописується тут, а не в contacts.yml:
        саме поле address іде ще в розмітку для пошуковиків, у блок
        «Майстерня і виїзд» і в меню, і там ця приписка була б або
        неправдою, або сміттям у структурованих даних.
      */
      { icon: 'pin', text: `${contacts.address} або за вашою адресою` },
      ...(meta.guarantee ? [{ icon: 'shield' as const, text: meta.guarantee }] : []),
    ]}
  />

  <RepairVsReplace />

  <Location coverage={site.coverage} address={contacts.address} />

  {show.gallery && <Gallery pairs={site.gallery} />}

  <Faq items={site.faq} />

  <LeadForm placement="form_home" hours={contacts.hours} />

  <!--
    Маркер глибини скролу для аналітики. Переїхав разом із відгуками, і
    не формально: подія scroll_75 означає рівно те, на якій висоті
    стоїть цей рядок.

    Виміряно на екрані 375px із порожньою галереєю: блок відгуків — це
    близько 1500px, блок питань — близько 390. Тому «лишити маркер там,
    де був» означало б посунути подію на ~1100px вище, і графік показав
    би зростання уваги там, де змінився лише порядок блоків.

    Тут маркер на 3233px при висоті сторінки 5536 — це 58%. До переносу
    він був би приблизно на 3700, тобто 67%. Ближче підсунути нічим:
    між формою й контактами іншого місця немає.

    Отже назва «75» умовна й була такою завжди. Якщо колись знадобиться
    справжня точність — рахувати відсоток скриптом, а не ставити якір
    руками; і памʼятати, що з наповненням галереї всі ці числа
    зміняться ще раз.
  -->
  <div id="scroll-depth-75" aria-hidden="true"></div>

  {show.reviews && <Reviews reviews={site.reviews} />}

  <Contacts contacts={contacts} showHours={show.hours} />

  <StickyCall phone={phone} viber={contacts.viber} telegram={contacts.telegram} />
</Base>
