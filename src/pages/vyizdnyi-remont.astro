---
import Base from '../layouts/Base.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import Analytics from '../components/Analytics.astro';
import StickyCall from '../components/StickyCall.astro';
import Prices from '../components/Prices.astro';
import LeadForm from '../components/LeadForm.astro';
import Contacts from '../components/Contacts.astro';
import { loadSite } from '../lib/site';
import { formatPhone, telHref } from '../lib/format';

const site = await loadSite('mobile');
const { contacts, coverage, meta, phone, show } = site;

const feeText =
  coverage.travel_fee === 0
    ? 'Виїзд безкоштовний'
    : `Виїзд — ${coverage.travel_fee} грн`;
---

<!--
  Друга сторінка існує не «щоб було», а під окремий пошуковий намір:
  «виїзний ремонт лобового скла», «ремонт скла з виїздом».
  У неї власний title, власний H1 і власна конверсійна воронка.

  FAQ-розмітка тут свідомо не дублюється (isMobilePage=true) —
  два FAQPage на одному домені з тими самими питаннями Google
  трактує як дубль і може зняти сніпет з обох.
-->
<Base title={meta.seo_title} description={meta.seo_description} phone={phone}>
  <SchemaOrg slot="head" site={site} isMobilePage={true} />
  <Analytics slot="head" gtmId={import.meta.env.PUBLIC_GTM_ID} />

  <section class="band mh">
    <h1>{meta.h1}</h1>
    {meta.hero_subtitle && <p class="mh__sub">{meta.hero_subtitle}</p>}
    <a class="btn btn--primary btn--lg" href={telHref(phone)} data-cta="hero_mobile">
      {formatPhone(phone)}
    </a>
    <p class="mh__fee">{feeText}</p>
    <div id="sticky-sentinel" aria-hidden="true"></div>
  </section>

  {show.coverage && (
    <section class="band area">
      <h2>Куди виїжджаємо</h2>
      <ul class="area__list">
        {coverage.areas.map((a) => <li>{a}</li>)}
      </ul>
      {coverage.radius_km && (
        <p class="area__note">Радіус виїзду — до {coverage.radius_km} км від міста.</p>
      )}
      <p class="area__note">
        Немає вашого району в списку? Зателефонуйте — часто можемо домовитись.
      </p>
    </section>
  )}

  {coverage.conditions && (
    <section class="band band--alt cond">
      <h2>Умови роботи на місці</h2>
      <p>{coverage.conditions}</p>
      <p class="cond__note">
        Полімер не застигає на морозі й не тримається на мокрому склі. Якщо
        погода не дозволяє — скажу відразу і запропоную приїхати до нас.
      </p>
    </section>
  )}

  <Prices services={site.services} phone={phone} />

  <!--
    Зворотне посилання на головну — поза умовними блоками навмисно.
    Якщо власник колись очистить «умови роботи», сторінка не має
    лишитися без єдиного змістового шляху назад.
  -->
  <p class="band back">
    <a href="/">Ремонт сколів у майстерні: ціни, приклади робіт, гарантія →</a>
  </p>

  <div id="scroll-depth-75" aria-hidden="true"></div>

  <LeadForm placement="form_mobile" />

  <Contacts contacts={contacts} showHours={show.hours} />

  <StickyCall phone={phone} viber={contacts.viber} telegram={contacts.telegram} />
</Base>

<style>
  .mh {
    display: grid;
    gap: 1.05rem;
    justify-items: start;
    background: linear-gradient(180deg, var(--accent-soft) 0%, var(--surface) 100%);
  }
  .mh h1 {
    margin: 0;
    font-size: clamp(1.85rem, 7vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-wrap: balance;
    max-width: 18ch;
  }
  .mh__sub {
    margin: 0;
    font-size: clamp(1.02rem, 3.4vw, 1.25rem);
    color: var(--muted);
    max-width: 38ch;
  }
  .mh__fee { margin: 0; font-size: 0.9rem; color: var(--muted); }

  .area, .cond { display: grid; gap: 0.85rem; }
  .area__list {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 0.45rem;
  }
  .area__list li {
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: var(--r-pill);
    background: var(--surface);
    font-size: 0.9rem;
    font-weight: 500;
  }
  .area__note, .cond__note { margin: 0; font-size: 0.9rem; line-height: 1.55; color: var(--muted); }

  /* Смуга без вертикальних відступів: це посилання, а не секція */
  .back {
    margin: 0;
    padding-block: 0 var(--section-y);
    font-size: 0.92rem;
  }
  .back a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
  }
  .back a:hover { text-decoration: underline; }

  .cond p { margin: 0; font-size: 0.95rem; line-height: 1.6; }

  @media (min-width: 768px) {
    .mh { padding: 3.5rem 2rem 2.5rem; }
    .area, .cond { padding: 3rem 2rem; }
  }
</style>
