---
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  phone?: string;
}
const { title, description, noindex = false, phone } = Astro.props;

// Канонічна адреса і og:url рахуються тут, а не в кожній сторінці.
// Раніше canonical жив у SchemaOrg і сторінки /thanks/ та /404 лишалися без нього.
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL('/og-default.jpg', Astro.site).toString();

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}

    <!-- Іконки. SVG для сучасних браузерів, PNG — для iOS,
         який svg на домашній екран не бере. -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1d4ed8" />

    <!--
      Посилання на сайт кидають у Viber і Telegram — там прев'ю з картинкою
      вирішує, чи його взагалі відкриють. Розміри вказані явно: без них
      месенджер малює порожню рамку, поки не дотягне сам файл.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="uk_UA" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Шрифт системний: нуль запитів, нуль FOUT, миттєвий рендер.
         Кастомний шрифт тут не додав би ані конверсії, ані довіри. -->
    <slot name="head" />
  </head>

  <body>
    <a class="skip" href="#main">Перейти до вмісту</a>

    <Header phone={phone} />

    <main id="main">
      <slot />
    </main>

    <!--
      Навігація переїхала в шапку. Тут лишилося те, місце чого справді
      внизу: юридичне посилання і ще одна нагода подзвонити для тих,
      хто дочитав до кінця.
    -->
    <footer class="foot">
      <div class="foot__inner">
        <p class="foot__legal">
          <a href="/polityka-konfidentsiynosti/">Політика конфіденційності</a>
        </p>
        <p class="foot__year">© {year}</p>
      </div>
    </footer>

    <style is:global>
      :root {
        /* Колір */
        --accent: #1d4ed8;
        --accent-strong: #1a3fb0;
        --accent-soft: #eef4ff;
        --text: #0f172a;
        --muted: #475569;
        --border: #e2e8f0;
        --surface: #ffffff;
        --surface-alt: #f8fafc;
        --star: #f59e0b;

        /* Форма */
        --r-sm: 10px;
        --r: 14px;
        --r-lg: 20px;
        --r-pill: 999px;

        /* Тінь одна на весь сайт: ледь помітний підйом, без «пластику» */
        --shadow: 0 1px 2px rgba(15, 23, 42, 0.04), 0 10px 26px -16px rgba(15, 23, 42, 0.28);

        /* Ритм */
        --container: 62rem;
        --section-y: clamp(2.25rem, 6vw, 4rem);
      }

      *, *::before, *::after { box-sizing: border-box; }

      html {
        -webkit-text-size-adjust: 100%;
        scroll-behavior: smooth;
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          transition-duration: 0.01ms !important;
        }
      }

      body {
        margin: 0;
        color: var(--text);
        background: var(--surface);
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        line-height: 1.55;
        /* Місце під sticky-панель, щоб вона не накривала контакти */
        padding-bottom: 5rem;
      }

      @media (min-width: 768px) {
        body { padding-bottom: 0; }
        /* Шапка на десктопі липка, тож якір не має ховатися під нею */
        html { scroll-padding-top: 5rem; }
      }

      img { max-width: 100%; height: auto; display: block; }

      :focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 2px;
        border-radius: 4px;
      }

      /* Посилання для тих, хто ходить із клавіатури: видиме тільки у фокусі */
      .skip {
        position: absolute;
        left: 0.5rem;
        top: -4rem;
        z-index: 100;
        padding: 0.65rem 1rem;
        border-radius: var(--r-sm);
        background: var(--accent);
        color: #fff;
        font-weight: 600;
        text-decoration: none;
        transition: top 0.15s ease-out;
      }
      .skip:focus { top: 0.5rem; }

      /*
        Смуга на всю ширину, вміст по центру і в межах контейнера.
        Внутрішній відступ рахується так, щоб не додавати зайвий <div>
        навколо кожної секції — інакше гриди всередині компонентів
        довелося б переписувати.
      */
      .band {
        padding-block: var(--section-y);
        padding-inline: max(1rem, calc((100% - var(--container)) / 2));
      }
      @media (min-width: 768px) {
        .band { padding-inline: max(1.5rem, calc((100% - var(--container)) / 2)); }
      }

      .band--alt { background: var(--surface-alt); }
      .band--tint { background: var(--accent-soft); }

      /* Заголовки секцій — однакові скрізь */
      .band > h2, .band > .band__head > h2 {
        margin: 0;
        font-size: clamp(1.5rem, 4.5vw, 2rem);
        line-height: 1.2;
        letter-spacing: -0.02em;
        text-wrap: balance;
      }

      /* Кнопки */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        min-height: 48px;
        padding: 0 1.25rem;
        border: 1px solid transparent;
        border-radius: var(--r);
        font-size: 1rem;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: background-color 0.15s ease-out, border-color 0.15s ease-out,
                    transform 0.1s ease-out;
      }
      .btn:active { transform: translateY(1px); }

      .btn--primary {
        background: var(--accent);
        color: #fff;
        box-shadow: var(--shadow);
      }
      .btn--primary:hover { background: var(--accent-strong); }

      .btn--ghost {
        background: var(--surface);
        border-color: var(--border);
        color: var(--text);
      }
      .btn--ghost:hover { border-color: var(--accent); color: var(--accent); }

      .btn--lg {
        min-height: 56px;
        padding: 0 1.5rem;
        font-size: 1.2rem;
        font-weight: 700;
      }

      /* Картка — одна форма на всі блоки */
      .card {
        padding: 1.15rem;
        border: 1px solid var(--border);
        border-radius: var(--r);
        background: var(--surface);
      }

      /* Футер */
      .foot {
        border-top: 1px solid var(--border);
        padding-block: 1.5rem;
        padding-inline: max(1rem, calc((100% - var(--container)) / 2));
      }
      .foot__inner {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 1.5rem;
        align-items: center;
        justify-content: space-between;
      }
      .foot p { margin: 0; font-size: 0.875rem; color: var(--muted); }
      .foot a {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        color: var(--muted);
      }
      .foot a:hover { color: var(--accent); }
    </style>
  </body>
</html>
