---
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  phone?: string;
  /* Прозора шапка поверх фотографії — тільки на головній */
  overHero?: boolean;
}
const { title, description, noindex = false, phone, overHero = false } = Astro.props;

// Канонічна адреса і og:url рахуються тут, а не в кожній сторінці.
// Раніше canonical жив у SchemaOrg і сторінки /thanks/ та /404 лишалися без нього.
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL('/og-default.jpg', Astro.site).toString();

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}

    <!-- Іконки. SVG для сучасних браузерів, PNG — для iOS,
         який svg на домашній екран не бере. -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1d4ed8" />

    <!--
      Посилання на сайт кидають у Viber і Telegram — там прев'ю з картинкою
      вирішує, чи його взагалі відкриють. Розміри вказані явно: без них
      месенджер малює порожню рамку, поки не дотягне сам файл.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="uk_UA" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <!--
      Шрифт свій, але не з CDN.

      README забороняє зовнішні шрифти, і це правильно: запит на чужий
      домен перед першим рендером — найдорожче, що можна зробити з LCP.
      Тут інакше: файл лежить на нашому ж домені, це один варіативний
      woff2 на 34 КБ із вирізаною кирилицею і латиницею, з preload
      і кешем на рік. Системний шрифт був головною причиною, чому
      сайт читався як шаблон.
    -->
    <link
      rel="preload"
      href="/fonts/onest-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <slot name="head" />
  </head>

  <body>
    <a class="skip" href="#main">Перейти до вмісту</a>

    <Header phone={phone} overHero={overHero} />

    <main id="main">
      <slot />
    </main>

    <!--
      Навігація переїхала в шапку. Тут лишилося те, місце чого справді
      внизу: юридичне посилання і ще одна нагода подзвонити для тих,
      хто дочитав до кінця.
    -->
    <footer class="foot">
      <div class="foot__inner">
        <p class="foot__legal">
          <a href="/polityka-konfidentsiynosti/">Політика конфіденційності</a>
        </p>
        <p class="foot__year">© {year}</p>
      </div>
    </footer>

    <style is:global>
      /*
        Варіативний Onest: одна вісь ваги 400–800, тож усі накреслення
        на сайті беруться з цього ж файлу без додаткових запитів.
        swap, а не block: текст показуємо системним шрифтом одразу,
        підміняємо, коли приїде свій. Порожній екран заради шрифта —
        гірше за коротку підміну.
      */
      @font-face {
        font-family: 'Onest';
        src: url('/fonts/onest-var.woff2') format('woff2');
        font-weight: 400 800;
        font-style: normal;
        font-display: swap;
      }

      :root {
        /*
          Сайт світлий завжди — незалежно від системної теми.

          Цей рядок не косметичний. Без нього браузер у людини з темною
          системною темою малює СВОЇ елементи форми темними: поле
          телефона, кнопку вибору файлу, прапорець згоди і смугу
          прокрутки. На білій сторінці це виглядає як поламана верстка.
          Тут ми прямо кажемо: сторінка світла, малюй відповідно.
        */
        color-scheme: light;

        /*
          Кожен колір сайту живе тут і тільки тут.
          Правило просте: у компонентах не має бути жодного #rrggbb —
          інакше однакові на вигляд відтінки розповзаються по файлах
          копіями, і будь-яка зміна палітри стає полюванням.
        */

        /* Акцент */
        --accent: #1d4ed8;
        --accent-strong: #1a3fb0;
        --accent-soft: #eef4ff;      /* тло акцентної смуги */
        --accent-line: #dbe6fb;      /* рамка картки на акцентній смузі */
        --on-accent: #ffffff;        /* текст поверх акценту */

        /* Текст */
        --text: #0f172a;
        --muted: #475569;
        /* Окремий токен для текстових посилань: на темній смузі
           акцентний синій по темно-синьому просто не читається */
        --link: var(--accent);

        /* Поверхні й лінії */
        --surface: #ffffff;
        --surface-alt: #f8fafc;
        --border: #e2e8f0;
        --border-strong: #cbd8e8;    /* рамка картки під курсором */
        --rule: #cbd5e1;             /* декоративні риски й маркери */
        --band-dark-bg: #0f172a;     /* тло темної смуги */

        /* Стани */
        --star: #f59e0b;
        --star-off: #dbe3ec;
        --danger: #b91c1c;
        --danger-soft: #fef2f2;

        /* Кольори поверх темної смуги — окремо, бо вони не залежать
           від того, світла тема на сайті чи темна */
        --on-dark: #cbd5e1;
        --on-dark-strong: #ffffff;
        --on-dark-muted: #94a3b8;
        --on-dark-link: #93b4fd;

        /* Форма */
        --r-sm: 10px;
        --r: 14px;
        --r-lg: 20px;
        --r-pill: 999px;

        /* Тінь одна на весь сайт: ледь помітний підйом, без «пластику» */
        --shadow: 0 1px 2px rgba(15, 23, 42, 0.04), 0 10px 26px -16px rgba(15, 23, 42, 0.28);
        --shadow-up: 0 -8px 24px -18px rgba(15, 23, 42, 0.45);

        /* Підпис поверх фотографії */
        --overlay: rgba(15, 23, 42, 0.78);
        --on-overlay: #ffffff;

        /* Скло на головній картинці */
        --glass-1: #e8effb;
        --glass-2: #cfdcf2;
        --glass-3: #aebfdb;
        --glass-crack: #64748b;
        --glass-sheen: #ffffff;
        --glass-edge: rgba(15, 23, 42, 0.08);

        /* Ритм */
        --container: 62rem;
        --section-y: clamp(2.25rem, 6vw, 4rem);

        /* Висота шапки. Живе токеном, бо на неї спираються три місця:
           сама шапка, відступ першого екрана під нею і компенсація
           якорів (scroll-padding-top). */
        --hdr-h: 60px;

        /*
          Затемнення першого екрана. Не підгін під поточну картинку:
          знімок замінять, і світле фото не має ламати текст. Щільність
          розрахована на найгірший випадок — біле фото: навіть у
          найсвітлішій точці (0.68) білий текст дає ~6:1.
        */
        --hero-scrim: linear-gradient(
          180deg,
          rgba(15, 23, 42, 0.82) 0%,
          rgba(15, 23, 42, 0.68) 42%,
          rgba(15, 23, 42, 0.78) 100%
        );
        /* Підсвітка кнопки поверх фото під курсором */
        --on-photo-wash: rgba(255, 255, 255, 0.16);
      }

      /* Рядок шапки на десктопі вищий — див. .hdr__inner */
      @media (min-width: 768px) {
        :root { --hdr-h: 68px; }
      }

      *, *::before, *::after { box-sizing: border-box; }

      html {
        -webkit-text-size-adjust: 100%;
        scroll-behavior: smooth;
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          transition-duration: 0.01ms !important;
        }
      }

      body {
        margin: 0;
        color: var(--text);
        background: var(--surface);
        font-family: 'Onest', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        line-height: 1.55;
        /* Місце під sticky-панель, щоб вона не накривала контакти */
        padding-bottom: 5rem;
      }

      /* Шапка липка на всіх ширинах, тож якір не має ховатися під нею */
      html { scroll-padding-top: calc(var(--hdr-h) + 0.5rem); }

      @media (min-width: 768px) {
        body { padding-bottom: 0; }
      }

      /*
        Привʼязка прокрутки — лише на межі першого екрана.

        Точок дві: сам перший екран і початок наступної секції. Решта
        сторінки не привʼязана взагалі: `proximity` притягує тільки
        поблизу точки, а елементів із scroll-snap-align більше немає,
        тож посеред довгого тексту ніщо не смикається.

        Для тих, хто попросив зменшити рух, привʼязки немає зовсім:
        різкий стрибок екрана при вестибулярних порушеннях — реальна
        проблема, а не незручність.
      */
      @media (prefers-reduced-motion: no-preference) {
        html { scroll-snap-type: y proximity; }
        .hero, .hero + * { scroll-snap-align: start; }
      }

      img { max-width: 100%; height: auto; display: block; }

      :focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 2px;
        border-radius: 4px;
      }

      /* Посилання для тих, хто ходить із клавіатури: видиме тільки у фокусі */
      .skip {
        position: absolute;
        left: 0.5rem;
        top: -4rem;
        z-index: 100;
        padding: 0.65rem 1rem;
        border-radius: var(--r-sm);
        background: var(--accent);
        color: var(--on-accent);
        font-weight: 600;
        text-decoration: none;
        transition: top 0.15s ease-out;
      }
      .skip:focus { top: 0.5rem; }

      /*
        Смуга на всю ширину, вміст по центру і в межах контейнера.
        Внутрішній відступ рахується так, щоб не додавати зайвий <div>
        навколо кожної секції — інакше гриди всередині компонентів
        довелося б переписувати.
      */
      .band {
        padding-block: var(--section-y);
        padding-inline: max(1rem, calc((100% - var(--container)) / 2));
      }
      @media (min-width: 768px) {
        .band { padding-inline: max(1.5rem, calc((100% - var(--container)) / 2)); }
      }

      .band--alt { background: var(--surface-alt); }
      .band--tint { background: var(--accent-soft); }

      /*
        Одна темна смуга на сторінку. Сенс не в моді: суцільно світла
        сторінка читається як документ, а не як сайт. Темний блок
        розрізає її навпіл і дає око, за що зачепитися.

        Приглушений колір тут перевизначається обов'язково — --muted
        розрахований на світле тло і на темному просто зникає.
      */
      .band--dark {
        background: var(--band-dark-bg);
        color: var(--on-dark);
        --text: var(--on-dark);
        --muted: var(--on-dark-muted);
        --border: rgba(255, 255, 255, 0.14);
        --border-strong: rgba(255, 255, 255, 0.24);
        --rule: rgba(255, 255, 255, 0.24);
        --surface: rgba(255, 255, 255, 0.05);
        --surface-alt: rgba(255, 255, 255, 0.05);
        --link: var(--on-dark-link);
      }
      .band--dark h2, .band--dark h3, .band--dark strong { color: var(--on-dark-strong); }
      .band--dark a:not(.btn) { color: var(--on-dark-link); }
      .band--dark :focus-visible { outline-color: var(--on-dark-link); }

      /* Заголовки секцій — однакові скрізь */
      .band > h2, .band > .band__head > h2 {
        margin: 0;
        font-size: clamp(1.5rem, 4.5vw, 2rem);
        line-height: 1.2;
        letter-spacing: -0.02em;
        text-wrap: balance;
      }

      /* Кнопки */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        min-height: 48px;
        padding: 0 1.25rem;
        border: 1px solid transparent;
        border-radius: var(--r);
        font-size: 1rem;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: background-color 0.15s ease-out, border-color 0.15s ease-out,
                    transform 0.1s ease-out;
      }
      .btn:active { transform: translateY(1px); }

      .btn--primary {
        background: var(--accent);
        color: var(--on-accent);
        box-shadow: var(--shadow);
      }
      .btn--primary:hover { background: var(--accent-strong); }

      .btn--ghost {
        background: var(--surface);
        border-color: var(--border);
        color: var(--text);
      }
      .btn--ghost:hover { border-color: var(--accent); color: var(--accent); }

      /*
        Друга кнопка першого екрана. Прозора навмисно: біла заливка
        поруч із синьою давала дві однаково гучні кнопки, а головна
        дія тут одна — дзвінок. Світла рамка — єдине, що на затемненому
        фото робить її кнопкою.
      */
      .btn--on-photo {
        background: transparent;
        border-color: var(--on-overlay);
        color: var(--on-overlay);
      }
      .btn--on-photo:hover { background: var(--on-photo-wash); }

      .btn--lg {
        min-height: 56px;
        padding: 0 1.5rem;
        font-size: 1.2rem;
        font-weight: 700;
      }

      /* Картка — одна форма на всі блоки */
      .card {
        padding: 1.15rem;
        border: 1px solid var(--border);
        border-radius: var(--r);
        background: var(--surface);
      }

      /* Футер */
      .foot {
        border-top: 1px solid var(--border);
        padding-block: 1.5rem;
        padding-inline: max(1rem, calc((100% - var(--container)) / 2));
      }
      .foot__inner {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 1.5rem;
        align-items: center;
        justify-content: space-between;
      }
      .foot p { margin: 0; font-size: 0.875rem; color: var(--muted); }
      .foot a {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        color: var(--muted);
      }
      .foot a:hover { color: var(--accent); }
    </style>
  </body>
</html>
