---
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="uk_UA" />

    <!-- Шрифт системний: нуль запитів, нуль FOUT, миттєвий рендер.
         Кастомний шрифт тут не додав би ані конверсії, ані довіри. -->
    <slot name="head" />
  </head>

  <body>
    <main>
      <slot />
    </main>

    <style is:global>
      :root {
        --accent: #1d4ed8;
        --text: #111827;
        --muted: #4b5563;
        --border: #e5e7eb;
        --surface: #ffffff;
        --surface-alt: #f9fafb;
      }

      *, *::before, *::after { box-sizing: border-box; }

      html { -webkit-text-size-adjust: 100%; }

      body {
        margin: 0;
        color: var(--text);
        background: var(--surface);
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        line-height: 1.5;
        /* Місце під sticky-панель, щоб вона не накривала контакти */
        padding-bottom: 5rem;
      }

      @media (min-width: 768px) {
        body { padding-bottom: 0; }
      }

      main { max-width: 900px; margin: 0 auto; }

      img { max-width: 100%; height: auto; display: block; }

      :focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 2px;
      }
    </style>
  </body>
</html>
