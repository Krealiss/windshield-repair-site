# Секрети для локального запуску: саме звідси wrangler бере
# TELEGRAM_BOT_TOKEN. Репозиторій публічний — токен у ньому означає,
# що будь-хто зможе писати від імені вашого бота і читати заявки.
# Шаблон навмисно широкий: файл із токеном уже одного разу зʼявився
# під назвою .dev1.vars.txt — Windows дописав .txt, а звичайне правило
# такого не ловило. Краще ігнорувати зайве, ніж пропустити токен.
.dev*.vars
.dev*.vars.*
*.vars.txt
!.dev.vars.example

# Локальні налаштування інструментів розробника — не спільні
.claude/settings.local.json

# Локальний конфіг wrangler: потрібен лише для команд d1 execute
wrangler.local.toml

# Робоча тека виконання планів: леджер, брифи, пакети рев'ю.
# Чернетки процесу, а не проєкту — історія git і є записом.
.superpowers/

# CRM: залежності, локальний конфіг і сховище воркера
crm/node_modules
crm/wrangler.local.toml
crm/.wrangler
