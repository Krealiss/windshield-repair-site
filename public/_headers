# Заголовки Cloudflare Pages.
#
# Файл лежить у public/, тобто потрапляє в dist як є. Правила застосовуються
# зверху вниз, точніший шлях перекриває загальний.

/*
  # Браузер не має вгадувати тип файлу за вмістом — на цьому будується
  # ціла родина атак, коли завантажене «фото» виявляється скриптом.
  X-Content-Type-Options: nosniff

  # Зовнішнім сайтам віддаємо тільки домен, без шляху. Сторінка подяки
  # не має світитися в чужій аналітиці як /thanks/.
  Referrer-Policy: strict-origin-when-cross-origin

  # Ніхто не вбудовує наш сайт у свій фрейм: захист від clickjacking,
  # коли кнопку «Подзвонити» накривають чужим прозорим шаром.
  X-Frame-Options: DENY

  # Камеру НЕ обмежуємо навмисно: у формі є input capture="environment",
  # і надіслати фото сколу з телефона важливіше за цей рядок.
  Permissions-Policy: geolocation=(), microphone=(), payment=(), usb=(), interest-cohort=()

  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # Про 'unsafe-inline' у script-src — чесно, бо це виглядає як недогляд.
  #
  # Astro вбудовує наші скрипти прямо в HTML (вони маленькі, окремий запит
  # коштував би дорожче), а GTM додає свої теги інлайном уже в браузері.
  # Ані хеші, ані nonce на статиці тут не працюють: хеш змінюється з кожною
  # правкою, а теги в GTM додають після збірки.
  #
  # Тому цей CSP обмежує не вбудовані скрипти, а все інше: звідки взагалі
  # можна вантажити код, куди можна відправити форму, чи можна підмінити
  # base-uri і вбудувати сторінку у фрейм. Це менше, ніж хотілося б,
  # але це не нуль.
  #
  # Якщо колись відмовитеся від GTM — приберіть 'unsafe-inline' і
  # googletagmanager з script-src, решта працюватиме без змін.
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.googletagmanager.com https://www.google-analytics.com; connect-src 'self' https://www.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; font-src 'self'

# Імена файлів тут містять хеш вмісту: якщо файл змінився — змінилася й адреса.
# Отже, кешувати можна назавжди.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Ім'я файлу шрифта не містить хеша, тому міняти його вміст «на місці»
# не можна — при оновленні шрифта дайте файлу нове ім'я.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/og-default.jpg
  Cache-Control: public, max-age=604800
