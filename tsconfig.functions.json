{
  // Перевірка типів для Cloudflare Pages Functions — нічого не збирає.
  //
  // Окремий конфіг, а не спільний із сайтом: у functions/** діє середовище
  // Workers, де Response, fetch і FormData не ті самі, що в браузері. Один
  // конфіг на обидві частини змушував би ці оголошення сперечатися.
  //
  // Запуск: npm run check:functions
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["functions/**/*.ts", "shared/**/*.ts"]
}
